                                                                                    "  pm.response.to.have.status(200);",
                                                                                    "});",
                                                                                    "const json = pm.response.json();",
                                                                                    "pm.test(\u0027Respuesta de confirmacion\u0027, function () {",
                                                                                    "  pm.expect(json.Ok).to.eql(true);",
                                                                                    "  pm.expect((json.Mensaje || \u0027\u0027).toLowerCase()).to.include(\u0027confirm\u0027);",
                                                                                    "});"
                                                                                ]
                                                                   }
                                                    }
                                                ]
